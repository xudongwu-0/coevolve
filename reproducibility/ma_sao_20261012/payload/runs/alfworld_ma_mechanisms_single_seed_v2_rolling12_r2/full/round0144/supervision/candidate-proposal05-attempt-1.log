{'status': 'complete', 'request_sha256': 'c379275966ea6c8a2c55a265d19d7beaa5a2790375711e4033d0ca0c022e2c41', 'sample_index': 5, 'decode_seed': 5005090, 'prompt_id': 'alfworld-packet-150-160-w1-sample5', 'model_label': 'candidate', 'valid': True, 'model_failure': None, 'patch': {'schema_version': 'harness-r1-patch-v1', 'benchmark': 'alfworld', 'description': 'Add compact stage tracking and soft ALFWorld guidance for transform-before-place tasks.', 'actions': [{'type': 'add_code_hook', 'hook': 'on_init', 'code': "def hook(ctx, nb):\n    nb['stage'] = 'find_target'\n    nb['transformed'] = False\n    nb['placed_count'] = 0\n    nb['last_hint'] = ''\n    text = 'Follow ALFWorld order: find and take the target, do any required clean heat cool or slice transform while holding it, then go to the destination and put it. For two-object tasks, leave placed items and place another target at the same destination.'\n    hint = 'Do not carry a transformed item to the destination and put it back in the transform place; after transforming, navigate to the destination.'\n    return {'skills': [{'text': text}], 'tool_hint': hint}"}, {'type': 'add_code_hook', 'hook': 'on_post_step', 'code': "def getv(ctx, path, default=None):\n    if isinstance(ctx, dict) and path in ctx:\n        return ctx.get(path, default)\n    cur = ctx\n    for part in path.split('.'):\n        if isinstance(cur, dict) and part in cur:\n            cur = cur.get(part)\n        else:\n            return default\n    return cur\n\ndef text(x):\n    if x is None:\n        return ''\n    return str(x).lower()\n\ndef needverb(tt):\n    if 'clean' in tt:\n        return 'clean'\n    if 'heat' in tt:\n        return 'heat'\n    if 'cool' in tt:\n        return 'cool'\n    if 'slice' in tt:\n        return 'slice'\n    return ''\n\ndef counttake(adm, target):\n    n = 0\n    for a in adm:\n        s = ' ' + text(a) + ' '\n        if target and (' take ' + target + ' ') in s:\n            n = n + 1\n    return n\n\ndef hook(ctx, nb):\n    world = ctx.get('world') or {}\n    tt = text(getv(ctx, 'task.task_type', ''))\n    target = text(getv(ctx, 'task.target_type', ''))\n    dest = text(getv(ctx, 'task.destination_type', ''))\n    verb = needverb(tt)\n    if not verb:\n        nb['transformed'] = True\n    act = text(getv(ctx, 'action.final_action', getv(ctx, 'action.normalized', getv(ctx, 'action.raw', ''))))\n    obs = text(ctx.get('observation', ''))\n    if target and verb and act.startswith(verb + ' ') and target in act and 'nothing happens' not in obs:\n        nb['transformed'] = True\n    if target and act.startswith('put ') and target in act and 'you put' in obs:\n        pc = nb.get('placed_count')\n        try:\n            pc = int(pc)\n        except Exception:\n            pc = 0\n        pc = pc + 1\n        nb['placed_count'] = pc\n    inv = world.get('inventory')\n    if isinstance(inv, list):\n        invs = ' '.join(text(x) for x in inv)\n    else:\n        invs = text(inv)\n    inv_nonempty = bool(invs) and 'nothing' not in invs and 'empty' not in invs and not (target and target in invs and 'not carrying' not in invs and 'not holding' not in invs)\n    has_target = bool(target and target in invs and 'not carrying' not in invs and 'not holding' not in invs)\n    admissible = ctx.get('admissible') or []\n    takes = counttake(admissible, target) if target else 0\n    if 'pick_two' in tt and nb.get('placed_count', 0) > 0 and not has_target and takes > 0:\n        nb['stage'] = 'find_target'\n    elif inv_nonempty and not has_target:\n        nb['stage'] = 'wrong_inventory'\n    elif target and verb and not nb.get('transformed') and has_target:\n        nb['stage'] = 'transform'\n    elif has_target and target and dest and (not verb or nb.get('transformed')):\n        nb['stage'] = 'put_target'\n    elif target and takes > 0:\n        nb['stage'] = 'take_target'\n    else:\n        nb['stage'] = 'find_target'\n    return None"}, {'type': 'add_code_hook', 'hook': 'make_pre_hint', 'code': "def getv(ctx, path, default=None):\n    if isinstance(ctx, dict) and path in ctx:\n        return ctx.get(path, default)\n    cur = ctx\n    for part in path.split('.'):\n        if isinstance(cur, dict) and part in cur:\n            cur = cur.get(part)\n        else:\n            return default\n    return cur\n\ndef needverb(tt):\n    if 'clean' in tt:\n        return 'clean'\n    if 'heat' in tt:\n        return 'heat'\n    if 'cool' in tt:\n        return 'cool'\n    if 'slice' in tt:\n        return 'slice'\n    return ''\n\ndef emit(nb, key, msg):\n    if not msg or nb.get('last_hint') == key:\n        return None\n    nb['last_hint'] = key\n    return {'message': msg}\n\ndef hook(ctx, nb):\n    tt = text(getv(ctx, 'task.task_type', ''))\n    target = text(getv(ctx, 'task.target_type', ''))\n    dest = text(getv(ctx, 'task.destination_type', ''))\n    verb = needverb(tt)\n    stage = nb.get('stage')\n    if 'pick_two' in tt and nb.get('placed_count', 0) > 0 and target and stage == 'find_target':\n        return emit(nb, 'two_target', 'Leave any target already placed at the destination; find another ' + target + ' and put it at the same ' + dest + '.')\n    if not verb or not target:\n        return None\n    if stage == 'transform' and verb == 'clean':\n        return emit(nb, 'clean', 'This is a clean task: hold the ' + target + ' and use an available clean action at the sinkbasin before placing it.')\n    if stage == 'transform' and verb == 'heat':\n        return emit(nb, 'heat', 'This is a heat task: hold the ' + target + ' and use an available heat action at the microwave before placing it.')\n    if stage == 'transform' and verb == 'cool':\n        return emit(nb, 'cool', 'This is a cool task: hold the ' + target + ' and use an available cool action at the fridge before placing it.')\n    if stage == 'transform' and verb == 'slice':\n        return emit(nb, 'slice', 'This is a slice task: hold the ' + target + ' and use an available slice action at the knife before placing it.')\n    if stage == 'put_target' and verb == 'clean':\n        return emit(nb, 'clean_dest', 'Do not put the ' + target + ' back in the sinkbasin after cleaning it; carry it to the ' + dest + ' and put it there.')\n    if stage == 'put_target' and verb == 'heat':\n        return emit(nb, 'heat_dest', 'Do not put the ' + target + ' back in the microwave after heating it; carry it to the ' + dest + ' and put it there.')\n    if stage == 'put_target' and verb == 'cool':\n        return emit(nb, 'cool_dest', 'Do not put the ' + target + ' back in the fridge after cooling it; carry it to the ' + dest + ' and put it there.')\n    if stage == 'put_target' and verb == 'slice':\n        return emit(nb, 'slice_dest', 'Do not put the ' + target + ' back at the knife after slicing it; carry it to the ' + dest + ' and put it there.')\n    return None"}]}, 'patch_sha256': 'fd4d0a532158abc3d478c5f89b86921d94d7038dbae243b2cf4d521c9dafb3d9'}
