d.get('final_action'):\n        action = str(actd.get('final_action') or actd.get('normalized') or actd.get('raw') or '')\n    elif isinstance(actd, dict) and actd.get('normalized'):\n        action = str(actd.get('normalized') or actd.get('raw') or '')\n    elif actd:\n        action = str(actd)\n    action = as_text(action)\n    if 'placed_items' not in nb:\n        nb['placed_items'] = []\n    if 'placed_locations' not in nb:\n        nb['placed_locations'] = []\n    target = task.get('target_type') or ''\n    dest = task.get('destination_type') or ''\n    tt = as_text(task.get('task_type') or ctx.get('task.task_type') or '')\n    verb = need_verb(tt)\n    admiss = ctx.get('admissible') or []\n    inv = as_text(world.get('inventory') or ctx.get('world.inventory') or '')\n    if 'nothing' in inv and 'not carrying' in inv:\n        inv = ''\n    if target and action.startswith('take ') and has_word(action, target):\n        nb['holding_target'] = True\n        nb['wrong_inventory'] = False\n    if target and action.startswith('put ') and has_word(action, target):\n        nb['holding_target'] = False\n    if target and verb and target in action and action.startswith(verb + ' '):\n        nb['transformed'] = True\n    pc = world.get('placed_count')\n    if isinstance(pc, int) and pc > nb.get('placed_count', 0):\n        nb['placed_count'] = pc\n    elif action.startswith('put ') and has_word(action, target) and dest and has_word(action, dest):\n        item = action[4:]\n        loc = item\n        if ' in/on ' in item:\n            parts = item.split(' in/on ')\n            item = parts[0]\n            loc = parts[1]\n        if item and item not in nb['placed_items']:\n            nb['placed_items'].append(item)\n        if loc and loc not in nb['placed_locations']:\n            nb['placed_locations'].append(loc)\n        nb['placed_count'] = len(nb['placed_items'])\n    carrying = bool(inv and 'nothing' not in inv and 'not carrying' not in inv)\n    holding = carrying and (not target or has_word(inv, target))\n    if holding and verb and not nb.get('transformed') and verb != 'slice':\n        nb['stage'] = 'transform'\n    elif carrying and target and not has_word(inv, target):\n        nb['stage'] = 'wrong_inventory'\n    elif holding and (not verb or nb.get('transformed')):\n        if dest and has_word(action, dest) and action.startswith('put '):\n            nb['stage'] = 'placed'\n        else:\n            nb['stage'] = 'go_destination'\n    else:\n        take_ok = False\n        for a in admiss:\n            if target and as_text(a).startswith('take ') and has_word(as_text(a), target):\n                take_ok = True\n        if take_ok and not holding and not (carrying and target and not has_word(inv, target)):\n            nb['stage'] = 'take_target'\n        else:\n            nb['stage'] = 'find_target'\n    nb['holding_target'] = holding\n    nb['target_type'] = target\n    nb['destination_type'] = dest\n    nb['task_type'] = tt\n    nb['verb'] = verb\n    return None"}, {'type': 'add_code_hook', 'hook': 'make_pre_hint', 'code': "def hook(ctx, nb):\n    target = nb.get('target_type') or 'target object'\n    dest = nb.get('destination_type') or 'destination'\n    stage = nb.get('stage')\n    verb = nb.get('verb')\n    msg = ''\n    if stage == 'wrong_inventory':\n        msg = 'You are carrying a non-target item. Do not place it at the goal; recover the ' + target + ' instead.'\n    elif stage == 'take_target':\n        msg = 'The ' + target + ' is available here. Take the target before continuing to search.'\n    elif stage == 'transform' and verb:\n        if verb in ['clean', 'heat', 'cool']:\n            msg = 'Carry the ' + target + ' to the ' + verb + ' station and use the ' + verb + ' action before placing it.'\n        else:\n            msg = 'Carry the ' + target + ' and use the required ' + verb + ' action before placing it.'\n    elif stage == 'go_destination':\n        msg = 'Carry the ' + target + ' to the ' + dest + ' and put it there; do not put it on unrelated surfaces.'\n    elif stage == 'find_target' and 'two' in (nb.get('task_type') or '') and nb.get('placed_count', 0) > 0:\n        msg = 'One ' + target + ' is already placed. Leave it there, find another ' + target + ', and use the same ' + dest + '.'\n    if not msg or msg == nb.get('last_hint'):\n        return None\n    nb['last_hint'] = msg\n    return {'message': msg}"}, {'type': 'add_code_hook', 'hook': 'on_before_action', 'code': "def as_text(x):\n    if x is None:\n        return ''\n    if isinstance(x, (list, tuple, set)):\n        return ' '.join([as_text(i) for i in x])\n    if isinstance(x, dict):\n        return ' '.join([as_text(k) + ' ' + as_text(v) for k, v in x.items()])\n    return str(x).lower()\n\ndef need_verb(tt):\n    if 'clean' in tt:\n        return 'clean'\n    if 'heat' in tt:\n        return 'heat'\n    if 'cool' in tt:\n        return 'cool'\n    if 'slice' in tt:\n        return 'slice'\n    return ''\n\ndef has_word(text, word):\n    return bool(word and word in text)\n\ndef hook(ctx, nb):\n    world = ctx.get('world') or {}\n    task = ctx.get('task') or {}\n    actd = ctx.get('action') or {}\n    action = ''\n    if isinstance(actd, dict) and actd.get('final_action'):\n        action = str(actd.get('final_action') or actd.get('normalized') or actd.get('raw') or '')\n    elif isinstance(actd, dict) and actd.get('normalized'):\n        action = str(actd.get('normalized') or actd.get('raw') or '')\n    elif actd:\n        action = str(actd)\n    action = as_text(action)\n    if not action:\n        return None\n    target = nb.get('target_type') or task.get('target_type') or ''\n    dest = nb.get('destination_type') or task.get('destination_type') or ''\n    tt = as_text(task.get('task_type') or ctx.get('task.task_type') or '')\n    verb = need_verb(tt)\n    admiss = ctx.get('admissible') or []\n    inv = as_text(world.get('inventory') or ctx.get('world.inventory') or '')\n    if 'nothing' in inv and 'not carrying' in inv:\n        inv = ''\n    carrying = bool(inv and 'nothing' not in inv and 'not carrying' not in inv)\n    holding = carrying and (not target or has_word(inv, target))\n    non_target = carrying and target and not has_word(inv, target)\n    if non_target and action.startswith('put ') and (not dest or has_word(action, dest)) and not (has_word(action, target) or has_word(action, 'target')):\n        return {'kind': 'block_and_prompt', 'message': 'This is not the target object. Do not place a non-target item at the goal; recover the target instead.'}\n    if 'two' in (nb.get('task_type') or '') and target and action.startswith('take ') and has_word(action, target) and nb.get('placed_count', 0) > 0:\n        items = nb.get('placed_items') or []\n        for item in items:\n            if item and item in action and item not in action.split(' from ')[-1]:\n                return {'kind': 'block_and_prompt', 'message': 'Do not take back an already placed target. Leave it there and find another target for the same destination.'}\n    if target and action.startswith('put ') and has_word(action, target) and dest and not has_word(action, dest) and verb and not nb.get('transformed') and (holding or (not carrying and target in action)):\n        if action in admiss or (not carrying and target in action and any(a.startswith('put ') and has_word(a, target) for a in admiss)):\n            return {'kind': 'block_and_prompt', 'message': 'This target still needs its required ' + verb + ' step before being placed. Go to the transform station first.'}\n    return None"}]}, 'patch_sha256': '13deb8fb43a3ca18f42380eefb2eb147339a28a74ed9d2c1fad02cdbee929b83'}
