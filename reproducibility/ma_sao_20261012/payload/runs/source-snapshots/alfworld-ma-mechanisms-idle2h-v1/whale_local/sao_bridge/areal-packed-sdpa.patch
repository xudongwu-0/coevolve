@@ -190,6 +190,18 @@ def _drop_multimodal_payloads(data: dict[str, Any]) -> None:
             data.pop(key, None)
 
 
+def _packed_causal_mask(
+    cu_seqlens: torch.Tensor, length: int, device: torch.device
+) -> torch.Tensor:
+    """Boolean [1, 1, L, L] causal mask that isolates packed sequences (True attends)."""
+    positions = torch.arange(length, device=device)
+    boundaries = cu_seqlens.to(device=device, dtype=torch.long)[1:]
+    # Tokens beyond the last boundary (padding) form one extra isolated segment.
+    segment = torch.searchsorted(boundaries, positions, right=True)
+    mask = (segment[:, None] == segment[None, :]) & (positions[:, None] >= positions[None, :])
+    return mask[None, None]
+
+
 def _prepare_multimodal_forward_inputs(
     mb: dict[str, Any],
