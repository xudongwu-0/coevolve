                 inputs.update(tree_kwargs)
                 tree_attn_keys = list(tree_kwargs.keys())
 
+            # SDPA ignores cu_seqlens: without an explicit block-diagonal mask, every
+            # packed sequence attends to all earlier sequences in its micro-batch.
+            if (
+                not self.enable_tree_training
+                and self.config.attn_impl == "sdpa"
+                and isinstance(inputs.get("attention_mask"), dict)
+                and inputs.get("cu_seq_lens_q") is not None
